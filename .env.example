# Copy to .env. This default is a known-good immutable multi-arch baseline.
# Replace it with a newer sha-* tag, version tag, or digest when upgrading.
NJU_INFO_IMAGE=ghcr.io/zhongyangchuwu/nju-info-hub:sha-8c71453

# Safe default: API is reachable only from this host.
NJU_INFO_BIND_ADDRESS=127.0.0.1
NJU_INFO_PORT=3000

# Optional overrides.
NJU_INFO_CONFIG_FILE=./instances/official.json
NJU_INFO_BACKUP_DIR=./backups
NJU_INFO_READY_TIMEOUT_SECONDS=900
