{
  "name": "nju-info-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "check": "pnpm -r check",
    "test": "pnpm -r test && node --test scripts/state-snapshot.test.mjs scripts/state-rclone.test.mjs",
    "test:state": "node --test scripts/state-snapshot.test.mjs scripts/state-rclone.test.mjs",
    "state:snapshot": "node scripts/state-snapshot.mjs",
    "nju-info": "pnpm --filter @nju-info/nju-info dev",
    "pack:release": "pnpm build && npm pack ./dist/release --pack-destination ./dist",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
