{
  "name": "nju-info-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test && node --test scripts/state-snapshot.test.mjs scripts/state-rclone.test.mjs",
    "worker": "pnpm --filter @nju-info/worker dev",
    "api": "pnpm --filter @nju-info/api dev",
    "mcp": "pnpm --filter @nju-info/mcp dev",
    "test:state": "node --test scripts/state-snapshot.test.mjs scripts/state-rclone.test.mjs",
    "state:snapshot": "node scripts/state-snapshot.mjs",
    "instance": "pnpm --filter @nju-info/instance-config instance"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
